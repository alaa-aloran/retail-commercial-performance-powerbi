	measure 'Return Rate KPI SVG' =
			VAR __SvgReturnRate = [Return Rate %]
			VAR RateText = IF ( ISBLANK ( __SvgReturnRate ), "No data", FORMAT ( __SvgReturnRate, "0.00%", "en-US" ) )
			VAR EncodedRate =
			    CONCATENATEX (
