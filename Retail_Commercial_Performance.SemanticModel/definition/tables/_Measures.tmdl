			        "%26%23" & FORMAT ( UNICODE ( MID ( RateText, [Value], 1 ) ), "0", "en-US" ) & "%3B",
			        "", [Value], ASC
			    )
			RETURN
			    "data:image/svg+xml;charset=utf-8,"
			        & "%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22296%22%20height%3D%22110%22%20viewBox%3D%220%200%20296%20110%22%20preserveAspectRatio%3D%22xMidYMid%20meet%22%20role%3D%22img%22%20aria-labelledby%3D%22title%22%3E%3Ctitle%20id%3D%22title%22%3EReturn%20rate%3A%20" & EncodedRate
			        & "%20(returned%20units%20divided%20by%20units%20sold)%3C%2Ftitle%3E%3Crect%20x%3D%22.5%22%20y%3D%22.5%22%20width%3D%22295%22%20height%3D%22109%22%20rx%3D%2212%22%20fill%3D%22%23F5F6F8%22%20stroke%3D%22%23D9DEE5%22%2F%3E%3Crect%20x%3D%2218%22%20y%3D%2231%22%20width%3D%2248%22%20height%3D%2248%22%20rx%3D%2211%22%20fill%3D%22%23E2E8F0%22%2F%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23AF593F%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20aria-hidden%3D%22true%22%3E%3Cpath%20d%3D%22m38%2046-7%207%207%207m-7-7h16a7%207%200%200%201%200%2014h-6%22%2F%3E%3C%2Fg%3E%3Cg%20font-family%3D%22Segoe%20UI%2C%20Arial%2C%20sans-serif%22%3E%3Ctext%20x%3D%2284%22%20y%3D%2229%22%20fill%3D%22%2364748B%22%20font-size%3D%2212%22%20font-weight%3D%22600%22%20letter-spacing%3D%221.2%22%3ERETURN%20RATE%3C%2Ftext%3E%3Ctext%20x%3D%2284%22%20y%3D%2263%22%20fill%3D%22%23102A4C%22%20font-size%3D%2230%22%20font-weight%3D%22700%22%3E" & EncodedRate
			        & "%3C%2Ftext%3E%3Ctext%20x%3D%2284%22%20y%3D%2288%22%20font-size%3D%2213%22%20font-weight%3D%22600%22%20fill%3D%22%2364748B%22%3EReturned%20units%20%C3%B7%20units%20sold%3C%2Ftext%3E%3C%2Fg%3E%3C%2Fsvg%3E"
		displayFolder: Product & Channel Performance\SVG KPIs
		lineageTag: 71c061ea-abea-41cf-acba-de50fd8c2d98
		dataCategory: ImageUrl

	measure 'Revenue YoY KPI SVG' =
			VAR __SvgYoYChange = [Executive Revenue Change]
			VAR SelectedYear = SELECTEDVALUE ( 'a_DimDate_portfolio'[Year] )
			VAR ValueText = IF ( ISBLANK ( __SvgYoYChange ), UNICHAR ( 8212 ), FORMAT ( __SvgYoYChange, "+0.00%;-0.00%;0.00%", "en-US" ) )
			VAR ContextText =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( SelectedYear ), "Select one year to compare",
			        ISBLANK ( __SvgYoYChange ), "No prior-year comparison",
			        "vs. " & FORMAT ( SelectedYear - 1, "0", "en-US" )
			    )
			VAR ValueColor = SWITCH ( TRUE (), __SvgYoYChange > 0, "16804A", __SvgYoYChange < 0, "C24141", "64748B" )
			VAR EncodedValue =
			    CONCATENATEX (
			        GENERATESERIES ( 1, LEN ( ValueText ) ),
			        "%26%23" & FORMAT ( UNICODE ( MID ( ValueText, [Value], 1 ) ), "0", "en-US" ) & "%3B",
			        "", [Value], ASC
			    )
			VAR EncodedContext =
			    CONCATENATEX (
			        GENERATESERIES ( 1, LEN ( ContextText ) ),
			        "%26%23" & FORMAT ( UNICODE ( MID ( ContextText, [Value], 1 ) ), "0", "en-US" ) & "%3B",
			        "", [Value], ASC
			    )
			RETURN
			    "data:image/svg+xml;charset=utf-8,"
			        & "%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22296%22%20height%3D%22110%22%20viewBox%3D%220%200%20296%20110%22%20preserveAspectRatio%3D%22xMidYMid%20meet%22%20role%3D%22img%22%20aria-labelledby%3D%22title%22%3E%3Ctitle%20id%3D%22title%22%3ERevenue%20year-over-year%3A%20" & EncodedValue & "%20" & EncodedContext
			        & "%3C%2Ftitle%3E%3Crect%20x%3D%22.5%22%20y%3D%22.5%22%20width%3D%22295%22%20height%3D%22109%22%20rx%3D%2212%22%20fill%3D%22%23F5F6F8%22%20stroke%3D%22%23D9DEE5%22%2F%3E%3Crect%20x%3D%2218%22%20y%3D%2231%22%20width%3D%2248%22%20height%3D%2248%22%20rx%3D%2211%22%20fill%3D%22%23E2E8F0%22%2F%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23245E98%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20aria-hidden%3D%22true%22%3E%3Cpath%20d%3D%22M31%2044v22h23M35%2059l6-7%205%202%207-9m-7%200h7v7%22%2F%3E%3C%2Fg%3E%3Cg%20font-family%3D%22Segoe%20UI%2C%20Arial%2C%20sans-serif%22%3E%3Ctext%20x%3D%2284%22%20y%3D%2229%22%20fill%3D%22%2364748B%22%20font-size%3D%2212%22%20font-weight%3D%22600%22%20letter-spacing%3D%221.2%22%3EREVENUE%20YOY%20%25%3C%2Ftext%3E%3Ctext%20x%3D%2284%22%20y%3D%2263%22%20fill%3D%22%23" & ValueColor & "%22%20font-size%3D%2230%22%20font-weight%3D%22700%22%3E" & EncodedValue
			        & "%3C%2Ftext%3E%3Ctext%20x%3D%2284%22%20y%3D%2288%22%20font-size%3D%2213%22%20font-weight%3D%22600%22%20fill%3D%22%2364748B%22%3E" & EncodedContext & "%3C%2Ftext%3E%3C%2Fg%3E%3C%2Fsvg%3E"
		displayFolder: Market & Sales Trends\SVG KPIs
		lineageTag: 621aef2f-22b4-4cd8-80bd-928af9855d7d
		dataCategory: ImageUrl

	measure 'Executive Return Rate Highlight' =
			VAR __PortfolioReturnRate = [Return Rate %]
			VAR __Categories =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( 'a_DimProduct_portfolio'[Category] ),
			            "@Units", [Units Sold],
			            "@ReturnRate", [Return Rate %]
			        ),
			        NOT ISBLANK ( 'a_DimProduct_portfolio'[Category] ) && [@Units] > 0 && NOT ISBLANK ( [@ReturnRate] )
			    )
			VAR __AboveBenchmark =
			    FILTER ( __Categories, ROUND ( ( [@ReturnRate] - __PortfolioReturnRate ) * 100, 2 ) > 0 )
			VAR __Focus =
			    TOPN ( 1, __AboveBenchmark, [@ReturnRate], DESC, [@Units], DESC, 'a_DimProduct_portfolio'[Category], ASC )
			VAR __Name = MAXX ( __Focus, 'a_DimProduct_portfolio'[Category] )
			VAR __Rate = MAXX ( __Focus, [@ReturnRate] )
			VAR __Gap = ( __Rate - __PortfolioReturnRate ) * 100
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( __PortfolioReturnRate ) || COUNTROWS ( __Categories ) < 2, "Select two or more categories with unit sales.",
			        ISEMPTY ( __Focus ), "No category exceeds the portfolio return rate at the displayed precision.",
			        __Name & " " & FORMAT ( __Rate, "0.00%" ) & " vs. "
			            & FORMAT ( __PortfolioReturnRate, "0.00%" ) & " portfolio (+" & FORMAT ( __Gap, "0.00" ) & " pp)"
			    )
		displayFolder: Executive Overview
		lineageTag: a1268691-d68d-4094-a833-c555841ea27b

	measure 'Executive Category Margin Background Color' =
			VAR __SelectedCategories = ALLSELECTED ( 'a_DimProduct_portfolio'[Category] )
			VAR __CategoryValue = [Profit Margin %]
			VAR __PortfolioValue = CALCULATE ( [Profit Margin %], __SelectedCategories )
			VAR __CategoryRounded = ROUND ( __CategoryValue, 4 )
			VAR __PortfolioRounded = ROUND ( __PortfolioValue, 4 )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISINSCOPE ( 'a_DimProduct_portfolio'[Category] )
			            || COUNTROWS ( __SelectedCategories ) < 2
			            || ISBLANK ( __CategoryValue )
			            || ISBLANK ( __PortfolioValue ), "#FFFFFF",
			        __CategoryRounded > __PortfolioRounded, "#E7F4EC",
			        __CategoryRounded < __PortfolioRounded, "#FBEAE7",
			        "#FFFFFF"
			    )
		isHidden
		displayFolder: Executive Overview
		lineageTag: 9dba3fdd-07df-42ac-b885-16f58e4df173

	measure 'Executive Category Return Rate Background Color' =
			VAR __SelectedCategories = ALLSELECTED ( 'a_DimProduct_portfolio'[Category] )
			VAR __CategoryValue = [Return Rate %]
			VAR __PortfolioValue = CALCULATE ( [Return Rate %], __SelectedCategories )
			VAR __CategoryRounded = ROUND ( __CategoryValue, 4 )
			VAR __PortfolioRounded = ROUND ( __PortfolioValue, 4 )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISINSCOPE ( 'a_DimProduct_portfolio'[Category] )
			            || COUNTROWS ( __SelectedCategories ) < 2
			            || ISBLANK ( __CategoryValue )
			            || ISBLANK ( __PortfolioValue ), "#FFFFFF",
			        __CategoryRounded < __PortfolioRounded, "#E7F4EC",
			        __CategoryRounded > __PortfolioRounded, "#FBEAE7",
			        "#FFFFFF"
			    )
		isHidden
		displayFolder: Executive Overview
		lineageTag: af16fe0e-9945-4587-b6bb-9e03e4f54d88

	measure 'Seasonality Tooltip Month' =
			VAR __MonthNumber = SELECTEDVALUE ( 'a_DimDate_portfolio'[MonthNo] )
			VAR __Year =
			    IF (
			        HASONEFILTER ( 'a_DimDate_portfolio'[Year] ),
			        SELECTEDVALUE ( 'a_DimDate_portfolio'[Year] )
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( __MonthNumber ),
			        FORMAT (
			            DATE ( COALESCE ( __Year, 2000 ), __MonthNumber, 1 ),
			            IF ( ISBLANK ( __Year ), "MMMM", "MMMM yyyy" ),
			            "en-US"
			        )
			    )
		displayFolder: Market & Sales Trends
		lineageTag: 1e79ecf9-4ab4-47bf-92a4-16865a95bfe1

	measure 'Seasonality Revenue Variance' =
			VAR __SelectedRevenue = [Selected-Year Monthly Revenue]
			VAR __HistoricalAverage = [Average Revenue by Calendar Month]
			RETURN
			    IF (
			        NOT ISBLANK ( __SelectedRevenue ) && NOT ISBLANK ( __HistoricalAverage ),
			        __SelectedRevenue - __HistoricalAverage
			    )
		formatString: +$#,0.00;-$#,0.00;$0.00
		displayFolder: Market & Sales Trends
		lineageTag: be70dc18-0448-438a-943e-66a3cef5e938

	measure 'Seasonality Revenue Variance %' = DIVIDE ( [Seasonality Revenue Variance], [Average Revenue by Calendar Month] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Market & Sales Trends
		lineageTag: 783754c9-a8dc-4c5e-b876-3c9633386e6a

